          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "(sum(sum by (node) (rate(node_rapl_package_joules_total[5m]))) + sum(sum by (node) (rate(node_rapl_dram_joules_total[5m]))) + count(node_uname_info) * $node_overhead_w + $nas_w) * 24 * 30.44 / 1000 * $price",
          "legendFormat": "__auto",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "renderer": "canvas",
        "editorMode": "code",
        "getOption": "const t = context.grafana.theme;\nconst series = context.panel.data.series;\nconst num = (s) => s.fields.find((f) => f.type === 'number');\nconst last = (ref) => {\n  const s = series.find((x) => x.refId === ref);\n  const f = s && num(s);\n  return f && f.values.length ? f.values[f.values.length - 1] : null;\n};\n\nconst w = last('A') || 0;\nconst eur = last('B') || 0;\nconst max = Math.max(150, Math.ceil((w * 1.6) / 50) * 50);\nconst grad = w < 150 ? '#2dd4bf' : w < 250 ? '#f5b73b' : '#f2495c';\nreturn {\n  backgroundColor: 'transparent',\n  textStyle: { fontFamily: t.typography.fontFamily },\n  series: [{\n    type: 'gauge', startAngle: 215, endAngle: -35, min: 0, max: max, splitNumber: 5,\n    radius: '95%', center: ['50%', '58%'],\n    progress: { show: true, roundCap: true, width: 14, itemStyle: { color: grad } },\n    axisLine: { roundCap: true, lineStyle: { width: 14, color: [ [1, 'rgba(142,154,175,0.16)'] ] } },\n    pointer: { show: false },\n    axisTick: { show: false },\n    splitLine: { length: 6, distance: 4, lineStyle: { width: 1, color: t.colors.border.medium } },\n    axisLabel: { distance: 14, color: t.colors.text.secondary, fontSize: 10 },\n    anchor: { show: false },\n    title: { offsetCenter: [0, '36%'], color: t.colors.text.secondary, fontSize: 12 },\n    detail: { valueAnimation: true, offsetCenter: [0, '2%'], fontSize: 30, fontWeight: 600,\n      color: t.colors.text.primary, formatter: (v) => Math.round(v) + ' W' },\n    data: [{ value: w, name: '\\u20ac' + eur.toFixed(2) + ' per month' }],\n  }],\n};\n",
        "map": "none",
        "editor": {
          "format": "auto"
        },
        "themeEditor": {
          "name": "default",
          "config": "{}"
        },
        "visualEditor": {
          "dataset": [],
          "series": [],
          "code": ""
        }
