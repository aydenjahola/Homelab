{
  "uid": "homelab-power",
  "title": "Power & cost",
  "description": "CPU power is measured with RAPL on each node. Wall power adds the per-node overhead (PSU loss, board, SSD, fans) and the NAS, which are estimates: adjust them at the top, or replace them with a smart plug reading.",
  "tags": [
    "homelab",
    "infrastructure"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "price",
        "label": "€ per kWh",
        "type": "textbox",
