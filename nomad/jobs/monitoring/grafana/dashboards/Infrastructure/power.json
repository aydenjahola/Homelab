        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "(sum(sum by (node) (rate(node_rapl_package_joules_total[5m]))) + sum(sum by (node) (rate(node_rapl_dram_joules_total[5m]))) + count(node_uname_info) * $node_overhead_w + $nas_w)",
          "legendFormat": "__auto",
          "refId": "A",
