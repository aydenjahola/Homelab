{
  "uid": "homelab-power",
  "title": "Power & cost",
  "description": "CPU power is measured with RAPL on each node. Wall power adds the per-node overhead (PSU loss, board, SSD, fans) and the NAS, which are estimates: adjust them at the top, or replace them with a smart plug reading.",
  "tags": [
    "homelab",
    "infrastructure"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "price",
        "label": "€ per kWh",
        "type": "textbox",
        "query": "0.35",
        "current": {
          "text": "0.35",
          "value": "0.35"
        },
        "options": []
      },
      {
        "name": "node_overhead_w",
        "label": "Per-node overhead (W)",
        "type": "textbox",
        "query": "12",
        "current": {
          "text": "12",
          "value": "12"
        },
        "options": []
      },
      {
        "name": "nas_w",
        "label": "NAS (W)",
        "type": "textbox",
