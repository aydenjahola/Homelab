          "text": "0.35",
          "value": "0.35"
        },
        "options": []
      },
      {
        "name": "node_overhead_w",
        "label": "Per-node overhead (W)",
        "type": "textbox",
        "query": "12",
        "current": {
          "text": "12",
          "value": "12"
        },
        "options": []
      },
      {
        "name": "nas_w",
        "label": "NAS (W)",
