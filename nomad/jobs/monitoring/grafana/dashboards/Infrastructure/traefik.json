    {
      "type": "volkovlabs-echarts-panel",
      "title": "Traffic punch card (7 days)",
      "description": "Requests per hour over the last week. Brighter cells are busier hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(traefik_service_requests_total{service=~\"$service\"}[1h]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "renderer": "canvas",
        "editorMode": "code",
        "getOption": "const t = context.grafana.theme;\nconst series = context.panel.data.series;\nconst num = (s) => s.fields.find((f) => f.type === 'number');\nconst last = (ref) => {\n  const s = series.find((x) => x.refId === ref);\n  const f = s && num(s);\n  return f && f.values.length ? f.values[f.values.length - 1] : null;\n};\n\nconst cells = {};\nconst now = new Date();\nconst days = [];\nfor (let i = 6; i >= 0; i--) {\n  days.push(new Date(now.getFullYear(), now.getMonth(), now.getDate() - i).toDateString());\n}\nseries.forEach((s) => {\n  const tf = s.fields.find((f) => f.type === 'time');\n  const vf = num(s);\n  if (!tf || !vf) return;\n  tf.values.forEach((ts, i) => {\n    const d = new Date(ts - 1);\n    const k = d.toDateString() + '|' + d.getHours();\n    cells[k] = (cells[k] || 0) + (vf.values[i] || 0);\n  });\n});\nconst data = [];\nlet max = 1;\ndays.forEach((day, y) => {\n  for (let h = 0; h < 24; h++) {\n    const v = Math.round(cells[day + '|' + h] || 0);\n    max = Math.max(max, v);\n    data.push([h, y, v]);\n  }\n});\nconst hours = Array.from({ length: 24 }, (_, h) => String(h).padStart(2, '0'));\nreturn {\n  backgroundColor: 'transparent',\n  textStyle: { fontFamily: t.typography.fontFamily },\n  tooltip: {\n    position: 'top',\n    formatter: (p) => {\n      const [h, y, v] = p.value;\n      return days[y].slice(0, 10) + ', ' + hours[h] + ':00  ' + v.toLocaleString() + ' requests';\n    },\n  },\n  grid: { left: 82, right: 12, top: 6, bottom: 48 },\n  xAxis: { type: 'category', data: hours, axisLine: { show: false }, axisTick: { show: false },\n    axisLabel: { color: t.colors.text.secondary } },\n  yAxis: { type: 'category', data: days.map((d) => d.slice(0, 10)), axisLine: { show: false },\n    axisTick: { show: false }, axisLabel: { color: t.colors.text.secondary } },\n  visualMap: { min: 0, max: max, orient: 'horizontal', left: 'center', bottom: 0, itemHeight: 160,\n    itemWidth: 10, textStyle: { color: t.colors.text.secondary }, inRange: { color: [\"#14161f\", \"#26215c\", \"#4c3fa8\", \"#8b7cf6\", \"#f472b6\", \"#ffb86b\"] } },\n  series: [{ type: 'heatmap', data: data,\n    itemStyle: { borderRadius: 4, borderColor: t.colors.background.primary, borderWidth: 2 },\n    emphasis: { itemStyle: { shadowBlur: 10, shadowColor: 'rgba(0,0,0,0.45)' } } }],\n};\n",
        "map": "none",
        "editor": {
          "format": "auto"
        },
        "themeEditor": {
          "name": "default",
          "config": "{}"
        },
        "visualEditor": {
          "dataset": [],
          "series": [],
          "code": ""
        }
      },
      "interval": "1h",
      "maxDataPoints": 200,
      "timeFrom": "7d",
      "hideTimeOverride": false,
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      }
