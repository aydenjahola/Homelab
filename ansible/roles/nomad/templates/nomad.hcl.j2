{#
  Rendered byte-identical to the live /etc/nomad.d/nomad.hcl on each host.
  The only semantic per-host value is the advertise address (host_ip).
  nomad_hcl_layout reproduces cosmetic drift between hosts:
    "odin"     - explicit plugin_dir (same value as Nomad's default
                 <data_dir>/plugins), no inline comments, odd alignment.
    "standard" - thor/loki layout with the stock inline comments.
  Both layouts are semantically identical apart from host_ip.
#}
{% if nomad_hcl_layout == 'odin' %}
data_dir   = "{{ nomad_data_dir }}"
plugin_dir = "{{ nomad_plugin_dir }}"

bind_addr = "{{ nomad_bind_addr }}"

advertise {
  http = "{{ host_ip }}"
  rpc  = "{{ host_ip }}"
  serf = "{{ host_ip }}"
}
{% else %}
data_dir  = "{{ nomad_data_dir }}"

bind_addr = "{{ nomad_bind_addr }}" # the default

advertise {
  # Defaults to the first private IP address.
  http = "{{ host_ip }}"
  rpc  = "{{ host_ip }}"
  serf = "{{ host_ip }}" # non-default ports may be specified
}
{% endif %}

server {
  enabled          = true
  bootstrap_expect = {{ nomad_bootstrap_expect }}

  job_gc_interval         = "1m"
  job_gc_threshold        = "1m"
  eval_gc_threshold       = "5m"
  batch_eval_gc_threshold = "5m"
  deployment_gc_threshold = "5m"

  raft_logstore {
    backend = "wal"
  }
}

client {
{% if nomad_hcl_layout == 'odin' %}
  enabled = true
{% else %}
  enabled       = true
{% endif %}

  gc_interval              = "30s"
  gc_max_allocs            = 10
  gc_disk_usage_threshold  = 70
  gc_inode_usage_threshold = 70
  gc_parallel_destroys     = 4
}

limits {
  http_max_conns_per_client = 0
}

plugin "raw_exec" {
  config {
    enabled = true
  }
}

plugin "docker" {
  config {
    allow_privileged = true
    volumes {
      enabled = true
    }
    allow_caps = [
      "audit_write",
      "chown",
      "dac_override",
      "fowner",
      "fsetid",
      "kill",
      "mknod",
      "net_bind_service",
      "net_admin",
      "net_raw",
      "net_broadcast",
      "setfcap",
      "setgid",
      "setpcap",
      "setuid",
      "sys_chroot"
    ]
  }
}

plugin "qemu" {
  config {
    image_paths = ["{{ nomad_qemu_image_path }}"]
  }
}

telemetry {
{% if nomad_hcl_layout == 'odin' %}
  collection_interval        = "1s"
{% else %}
  collection_interval       = "1s"
{% endif %}
  publish_allocation_metrics = true
  publish_node_metrics       = true
  prometheus_metrics         = true
}
