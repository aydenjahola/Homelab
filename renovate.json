{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Dublin",
  "dependencyDashboard": true,
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker images in Nomad job specs",
      "managerFilePatterns": ["/^nomad/jobs/.+\\.hcl$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\":@]+(?::\\d+/[^\":@]+)?):(?<currentValue>[^\"@]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Patch and digest updates auto-merge after 3 days once CI passes",
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Minor updates auto-merge after 7 days once CI passes",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Critical apps: minor updates need a manual merge",
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": [
        "ghcr.io/goauthentik/server",
        "traefik",
        "vaultwarden/server",
        "ghcr.io/jpvenson/jellyfin.pgsql"
      ],
      "automerge": false
    },
    {
      "description": "Major updates always need a manual merge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "CI Python must stay on a version ansible-core supports (2.19 breaks on 3.15): manual merge",
      "matchDepNames": ["python"],
      "automerge": false
    },
    {
      "description": "Database majors need a dump and restore: never propose them",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "postgres",
        "timescale/timescaledb",
        "timescale/timescaledb-ha",
        "lscr.io/linuxserver/mariadb",
        "clickhouse/clickhouse-server"
      ],
      "enabled": false
    },
    {
      "description": "Seerr runs a moving preview tag by choice",
      "matchPackageNames": ["ghcr.io/seerr-team/seerr"],
      "enabled": false
    },
    {
      "description": "linuxserver.io tags carry a build suffix (-lsNNN)",
      "matchPackageNames": ["/^lscr\\.io/linuxserver//"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:-r\\d+)?-ls(?<revision>\\d+)$"
    }
  ]
}
